# Copy to .env and fill in your own Foundry resource. No keys needed: Gantry signs in with
# Microsoft Entra ID (az login locally, managed identity in Azure).
AZURE_AI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<your-foundry-resource>
AZURE_SPEECH_REGION=eastus2
GANTRY_MODEL_FAST=gpt-5.4-mini
GANTRY_MODEL_SMART=gpt-5.4-mini
