# Copy to .env and fill in your own Foundry resource. No keys needed: Gantry signs in with
# Microsoft Entra ID (az login locally, a managed identity in Azure).
# Without these, the produced broadcast still plays; only the live crew needs them.
AZURE_AI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
AZURE_SPEECH_REGION=eastus2

# Which model each role uses (these are the defaults)
GANTRY_MODEL_CALL=gpt-5.4-mini
GANTRY_MODEL_LINES=gpt-5.4-mini
GANTRY_MODEL_DESK=gpt-5-mini
GANTRY_MODEL_DIRECTOR=gpt-5-mini
GANTRY_MODEL_EDITOR=gpt-5-mini
GANTRY_MODEL_PRODUCER=gpt-5-mini

# Optional
# GANTRY_PUBLIC=1        on the internet: the default broadcast plays from its production, live work is limited
# GANTRY_VOICE=off       captions only, no speech synthesis
# GANTRY_TRACING=off     don't send traces to Application Insights
